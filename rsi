#!/usr/bin/env python3
"""Launcher of the RSI control program: puts control/ (beside this file's real path) on sys.path and runs it.

Its own folder is taken off sys.path first, so nothing at the RSI root can shadow a module.
"""
import sys
from pathlib import Path

here = Path(__file__).resolve().parent
sys.path[:] = [entry for entry in sys.path if Path(entry or '.').resolve() != here]
sys.path.insert(0, str(here / 'control'))

from rsi.cli import main  # noqa: E402

sys.exit(main())
